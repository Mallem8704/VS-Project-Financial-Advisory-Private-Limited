datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  DIRECTOR
  ADMIN
  ADVISOR
  FINANCIAL_ANALYST
  DOCUMENT_EXECUTIVE
  RELATIONSHIP_MANAGER
  CONTENT_MANAGER
  SUPPORT
  CLIENT
  // Legacy compatibility aliases
  LEAD_ADVISOR
  ANALYST
  PARTNER_CA
}

enum BusinessConstitution {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  TRUST_SOCIETY
  OTHER
}

enum ProjectStageType {
  // 11 Core Institutional Lifecycle Stages
  ONBOARDING
  DOCUMENT_COLLECTION
  FINANCIAL_ASSESSMENT
  DPR_PREPARATION
  CMA_PREPARATION
  APPLICATION_PREPARATION
  SUBMITTED_TO_INSTITUTION
  QUERY_RESOLUTION
  DECISION_OR_SANCTION
  POST_SANCTION
  COMPLETED
  // Legacy aliases
  IDEA_FEASIBILITY
  BUSINESS_SETUP
  COMPLIANCE_REGISTRATIONS
  PROJECT_PLANNING
  CMA_DATA_PREPARATION
  FINANCIAL_MODELLING
  FINANCE_READINESS_REVIEW
  LOAN_PRODUCT_DISCOVERY
  BANK_COORDINATION
  SANCTION_DECISION
  POST_SANCTION_DISBURSEMENT
}

enum ProjectStatus {
  IN_PROGRESS
  PENDING_CLIENT_ACTION
  PENDING_ADVISOR_ACTION
  BANK_SUBMISSION
  SANCTIONED
  REVISION_REQUIRED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FinancialInstitutionType {
  PUBLIC_SECTOR_BANK
  PRIVATE_BANK
  NBFC
  DEVELOPMENT_FINANCIAL_INSTITUTION
  COOPERATIVE_BANK
  FOREIGN_BANK
  OTHER
}

enum ApplicationStatus {
  DRAFT
  DOCUMENTATION_PENDING
  SUBMITTED
  UNDER_APPRAISAL
  QUERIES_RAISED
  SANCTIONED
  REJECTED
  DISBURSED
  WITHDRAWN
}

enum DocumentCategory {
  KYC_PROMOTER
  STATUTORY_REGISTRATIONS
  PAST_FINANCIALS_AUDITED
  BANK_STATEMENTS
  PROJECT_COST_ESTIMATES_QUOTATIONS
  COLLATERAL_LEGAL_DOCS
  CMA_REPORT
  DPR_REPORT
  SANCTION_LETTER
  OTHER
}

enum DocumentStatus {
  PENDING_UPLOAD
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  CLOSED
}

enum ConversationType {
  DIRECT
  PROJECT_TEAM
  ADVISORY_DESK
}

enum NotificationType {
  INFO
  ACTION_REQUIRED
  STATUS_UPDATE
  WARNING
  SUCCESS
}

enum ReadinessBand {
  EARLY_PREPARATION
  DEVELOPING_READINESS
  MODERATE_READINESS
  STRONG_READINESS
  ADVANCED_READINESS
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMBER
  CURRENCY
  PERCENTAGE
  YES_NO
  DATE
  TEXT
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
  ARCHIVED
}

// ============================================================================
// 1. IDENTITY, ACCESS CONTROL & ORGANIZATION
// ============================================================================

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String
  fullName            String
  role                UserRole        @default(CLIENT)
  phone               String?
  avatarUrl           String?
  isMfaEnabled        Boolean         @default(false)
  mfaSecret           String?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  emailVerified       DateTime?
  backupCodesJson     String?
  status              String          @default("ACTIVE")
  lastLoginAt         DateTime?
  lastLoginIp         String?
  organizationId      String?
  organization        Organization?   @relation(fields: [organizationId], references: [id])
  clientProfile       ClientProfile?
  companyProfile      CompanyProfile? // Legacy compatibility

  // Relations
  userRoles             UserRoleAssignment[]
  assignedProjects      Project[]                @relation("AdvisorAssignedProjects")
  clientProjects        Project[]                @relation("ClientCreatedProjects")
  assignedProjectStages ProjectStage[]           @relation("AdvisorAssignedStages")
  assignedProjectTasks  ProjectTask[]            @relation("AssignedProjectTasks")
  assignedTasks         Task[]                   @relation("AssignedTasks")
  createdTasks          Task[]                   @relation("CreatedTasks")
  leadsAssigned         Lead[]                   @relation("AdvisorAssignedLeads")
  leadActivities        LeadActivity[]
  consultations         Consultation[]
  meetings              Meeting[]
  tickets               Ticket[]
  supportTickets        SupportTicket[] // Legacy compatibility
  ticketMessages        TicketMessage[]
  messagesSent          Message[]                @relation("SentMessages")
  messagesReceived      Message[]                @relation("ReceivedMessages")
  notifications         Notification[]
  auditLogs             AuditLog[]
  fileAccessLogs        FileAccessLog[]
  aiRequests            AIRequest[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  verificationTokens    EmailVerificationToken[]

  // Readiness Engine
  readinessAssessments FinanceReadinessAssessment[]
  assessments          Assessment[] // Legacy compatibility

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([status])
}

model Organization {
  id                    String               @id @default(cuid())
  name                  String
  legalName             String?
  constitution          BusinessConstitution @default(PRIVATE_LIMITED)
  panNumber             String?
  gstNumber             String?
  udyamNumber           String?
  cinNumber             String?
  industry              String?
  businessVintageYears  Int                  @default(0)
  annualTurnoverInLakhs Float                @default(0)
  existingDebtInLakhs   Float                @default(0)
  address               String?
  city                  String?
  state                 String?
  pinCode               String?
  status                String               @default("ACTIVE")

  // Relations
  users          User[]
  clientProfiles ClientProfile[]
  projects       Project[]
  invoices       Invoice[]
  subscriptions  Subscription[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([gstNumber])
  @@index([panNumber])
}

model Role {
  id          String               @id @default(cuid())
  code        String               @unique // e.g. SUPER_ADMIN, ADVISOR, FINANCIAL_ANALYST
  name        String
  description String?
  isSystem    Boolean              @default(false)
  status      String               @default("ACTIVE")
  permissions RolePermission[]
  users       UserRoleAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([code])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. projects.view, dpr.create, cma.create
  name        String
  module      String // e.g. projects, documents, billing, users
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([code])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  createdAt    DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model ClientProfile {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId          String?
  organization            Organization? @relation(fields: [organizationId], references: [id])
  authorizedSignatoryName String?
  designation             String?
  netWorthInLakhs         Float?
  cibilScore              Int?
  directorsJson           String? // JSON array of promoters/directors
  bankRelationshipsJson   String? // JSON array of existing lending banks
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime @default(now())
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// Legacy compatibility
model CompanyProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String
  constitution          BusinessConstitution @default(PRIVATE_LIMITED)
  udyamNumber           String?
  gstNumber             String?
  panNumber             String?
  cinNumber             String?
  industrySector        String
  businessVintageYears  Int                  @default(0)
  annualTurnoverInLakhs Float                @default(0)
  existingDebtInLakhs   Float                @default(0)
  address               String?
  state                 String?
  pinCode               String?
  projects              Project[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

// ============================================================================
// 2. CRM & LEAD PIPELINE
// ============================================================================

model Lead {
  id                  String         @id @default(cuid())
  fullName            String
  email               String
  phone               String
  businessName        String
  industry            String
  estimatedLoanAmount Float? // in Lakhs
  loanType            String?
  source              String         @default("WEBSITE_INTAKE")
  status              LeadStatus     @default(NEW)
  assignedAdvisorId   String?
  assignedAdvisor     User?          @relation("AdvisorAssignedLeads", fields: [assignedAdvisorId], references: [id])
  assignedAdvisorName String? // Legacy fallback
  convertedToUserId   String?
  notes               String?
  activities          LeadActivity[]
  consultations       Consultation[]
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([email])
  @@index([assignedAdvisorId])
}

model LeadActivity {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          String // CALL, EMAIL, MEETING, NOTE, STATUS_CHANGE
  description   String
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  metadataJson  String?
  createdAt     DateTime @default(now())

  @@index([leadId])
  @@index([performedById])
}

model Consultation {
  id                String    @id @default(cuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])
  leadId            String?
  lead              Lead?     @relation(fields: [leadId], references: [id])
  serviceType       String // e.g. "Term Loan Advisory", "DPR Preparation"
  preferredDate     DateTime?
  preferredTimeSlot String?
  topic             String
  status            String    @default("REQUESTED") // REQUESTED, SCHEDULED, COMPLETED, CANCELLED
  notes             String?
  meeting           Meeting?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([status])
}

// ============================================================================
// 3. CORE ADVISORY PROJECTS & WORKFLOW
// ============================================================================

model Project {
  id                          String           @id @default(cuid())
  clientId                    String
  client                      User             @relation("ClientCreatedProjects", fields: [clientId], references: [id])
  organizationId              String?
  organization                Organization?    @relation(fields: [organizationId], references: [id])
  companyId                   String? // Legacy compatibility
  company                     CompanyProfile?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                       String
  projectType                 String           @default("TERM_LOAN") // TERM_LOAN, WORKING_CAPITAL, GREENFIELD, SUBSIDY
  industry                    String
  projectSector               String? // Legacy alias for industry
  projectCost                 Float // In Lakhs
  totalProjectCostInLakhs     Float? // Legacy alias
  financeRequirement          Float // In Lakhs
  requestedLoanAmountInLakhs  Float? // Legacy alias
  promoterContribution        Float?           @default(0)
  promoterContributionInLakhs Float? // Legacy alias
  targetLenders               String? // Comma-separated or JSON target banks
  status                      ProjectStatus    @default(IN_PROGRESS)
  currentStage                ProjectStageType @default(ONBOARDING)
  assignedAdvisorId           String?
  assignedAdvisor             User?            @relation("AdvisorAssignedProjects", fields: [assignedAdvisorId], references: [id])
  leadAdvisorId               String? // Legacy alias
  targetDate                  DateTime?
  targetCompletionDate        DateTime? // Legacy alias
  completionPercentage        Int              @default(0)
  createdBy                   String?
  updatedBy                   String?

  // Relations
  stages           ProjectStage[]
  milestones       ProjectMilestone[] // Legacy compatibility
  projectTasks     ProjectTask[]
  activities       ProjectActivity[] // Legacy compatibility
  applications     Application[]
  documents        Document[]
  documentRequests DocumentRequest[]
  dprs             DPR[]
  cmas             CMA[]
  financialModels  FinancialModel[]
  invoices         Invoice[]
  messages         Message[]
  conversations    Conversation[]
  tickets          Ticket[]
  supportTickets   SupportTicket[] // Legacy compatibility
  meetings         Meeting[]
  cmaWorkspaces    CmaWorkspace[] // Legacy compatibility
  dprWorkspaces    DprWorkspace[] // Legacy compatibility

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
  @@index([organizationId])
  @@index([assignedAdvisorId])
  @@index([currentStage])
  @@index([status])
}

model ProjectStage {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage        ProjectStageType
  title        String
  status       String           @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED
  orderIndex   Int              @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  assignedToId String?
  assignedTo   User?            @relation("AdvisorAssignedStages", fields: [assignedToId], references: [id])
  tasks        ProjectTask[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId])
  @@index([stage])
  @@index([status])
}

model ProjectTask {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectStageId String?
  projectStage   ProjectStage? @relation(fields: [projectStageId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  priority       TaskPriority  @default(MEDIUM)
  status         TaskStatus    @default(TODO)
  assignedToId   String?
  assignedTo     User?         @relation("AssignedProjectTasks", fields: [assignedToId], references: [id])
  dueDate        DateTime?
  completedAt    DateTime?
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projectId])
  @@index([projectStageId])
  @@index([assignedToId])
  @@index([status])
}

// Legacy milestone model
model ProjectMilestone {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage        ProjectStageType
  title        String
  description  String?
  isCompleted  Boolean          @default(false)
  completedAt  DateTime?
  orderIndex   Int              @default(0)
  pendingActor String           @default("VS Advisory")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId])
}

// Legacy project activity model
model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actorName String
  actorRole String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ============================================================================
// 4. INSTITUTIONAL LENDING & APPLICATIONS
// ============================================================================

model FinancialInstitution {
  id                    String                   @id @default(cuid())
  name                  String
  code                  String                   @unique // e.g. SBI, HDFC, SIDBI, BOB, PNB
  type                  FinancialInstitutionType @default(PUBLIC_SECTOR_BANK)
  category              String? // MSME Preferred, Infrastructure, Large Corporate
  headquartersCity      String?
  contactPerson         String?
  email                 String?
  phone                 String?
  websiteUrl            String?
  portalUrl             String?
  supportedProductsJson String? // JSON array of loan schemes
  status                String                   @default("ACTIVE")
  applications          Application[]
  deletedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([code])
  @@index([type])
  @@index([status])
}

model Application {
  id                String               @id @default(cuid())
  projectId         String
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  institutionId     String
  institution       FinancialInstitution @relation(fields: [institutionId], references: [id])
  applicationNumber String?              @unique
  loanProduct       String // e.g. "Term Loan - MSME Scheme", "Working Capital Facility"
  requestedAmount   Float // In Lakhs
  sanctionedAmount  Float? // In Lakhs
  interestRate      Float? // e.g. 9.25
  tenureMonths      Int?
  status            ApplicationStatus    @default(DRAFT)
  submittedAt       DateTime?
  sanctionedAt      DateTime?
  sanctionLetterKey String? // Secure S3 object key
  rejectionReason   String?
  notes             String?
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([projectId])
  @@index([institutionId])
  @@index([status])
  @@index([applicationNumber])
}

// ============================================================================
// 5. SECURE DOCUMENT MANAGEMENT
// ============================================================================

model Document {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category         DocumentCategory
  title            String
  fileName         String
  fileKey          String // Secure S3 object key (no public URL)
  fileSize         Int               @default(0)
  mimeType         String            @default("application/pdf")
  status           DocumentStatus    @default(PENDING_UPLOAD)
  rejectionRemarks String?
  uploadedByUserId String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  currentVersion   Int               @default(1)
  versions         DocumentVersion[]
  accessLogs       FileAccessLog[]
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([category])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int
  fileName         String
  fileKey          String
  fileSize         Int
  mimeType         String
  uploadedByUserId String?
  changeSummary    String?
  createdAt        DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentRequest {
  id                  String           @id @default(cuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  category            DocumentCategory
  status              String           @default("PENDING") // PENDING, FULFILLED, WAIVED
  requestedByUserId   String?
  dueDate             DateTime?
  fulfilledDocumentId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([projectId])
  @@index([status])
}

model FileAccessLog {
  id                String   @id @default(cuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String?
  accessedByUserId  String
  accessedByUser    User     @relation(fields: [accessedByUserId], references: [id])
  action            String   @default("DOWNLOAD") // VIEW, DOWNLOAD, PREVIEW
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([documentId])
  @@index([accessedByUserId])
  @@index([action])
}

// ============================================================================
// 6. FINANCIAL ENGINEERING (DPR, CMA & FINANCIAL MODELS)
// ============================================================================

model DPR {
  id                   String       @id @default(cuid())
  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  version              Int          @default(1)
  status               String       @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, FINALIZED
  executiveSummary     String?
  promoterBackground   String?
  technicalFeasibility String?
  marketAnalysis       String?
  costEstimatesJson    String? // JSON breakdown of project costs
  meansOfFinanceJson   String? // JSON debt-equity-subsidy mix
  projectionsJson      String? // JSON 5-7 year revenue & profit projections
  swotAnalysisJson     String? // JSON strengths, weaknesses, ops, threats
  versions             DPRVersion[]
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
}

model DPRVersion {
  id              String   @id @default(cuid())
  dprId           String
  dpr             DPR      @relation(fields: [dprId], references: [id], onDelete: Cascade)
  versionNumber   Int
  contentJson     String
  generatedPdfKey String?
  createdByUserId String?
  changeNotes     String?
  createdAt       DateTime @default(now())

  @@unique([dprId, versionNumber])
  @@index([dprId])
}

model CMA {
  id                  String       @id @default(cuid())
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  version             Int          @default(1)
  status              String       @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, FINALIZED
  historicalYears     Int          @default(3)
  projectedYears      Int          @default(5)
  operatingDataJson   String // JSON containing Form I to Form VI
  mpbfMethod1         Float? // Tandon Method 1 Working Capital
  mpbfMethod2         Float? // Tandon Method 2 Working Capital
  dscrAverage         Float?
  currentRatioAverage Float?
  versions            CMAVersion[]
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
}

model CMAVersion {
  id                   String   @id @default(cuid())
  cmaId                String
  cma                  CMA      @relation(fields: [cmaId], references: [id], onDelete: Cascade)
  versionNumber        Int
  operatingDataJson    String
  financialSummaryJson String?
  createdByUserId      String?
  changeNotes          String?
  createdAt            DateTime @default(now())

  @@unique([cmaId, versionNumber])
  @@index([cmaId])
}

model FinancialModel {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  modelType       String    @default("DCF_PROJECTION") // DCF_PROJECTION, SENSITIVITY, BREAK_EVEN, WORKING_CAPITAL
  inputsJson      String
  outputsJson     String
  irrPercent      Float?
  npvValue        Float?
  paybackYears    Float?
  status          String    @default("DRAFT")
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([modelType])
}

// Legacy workspaces
model CmaWorkspace {
