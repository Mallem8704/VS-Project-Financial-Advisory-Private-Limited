  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  executiveSummary     String?
  promoterBackground   String?
  technicalFeasibility String?
  marketPotential      String?
  financialPlan        String?
  swotAnalysis         String?
  status               String   @default("DRAFT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
}

// ============================================================================
// 7. FINANCE READINESS ENGINE
// ============================================================================

model FinanceReadinessAssessment {
  id           String                     @id @default(cuid())
  userId       String?
  user         User?                      @relation(fields: [userId], references: [id])
  guestEmail   String?
  guestName    String?
  guestPhone   String?
  guestCompany String?
  status       AssessmentStatus           @default(DRAFT)
  responses    FinanceReadinessResponse[]
  result       FinanceReadinessResult?
  deletedAt    DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
}

model FinanceReadinessResponse {
  id           String                     @id @default(cuid())
  assessmentId String
  assessment   FinanceReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionKey  String
  valueString  String?
  valueNumber  Float?
  valueBoolean Boolean?
  valueJson    String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([assessmentId, questionKey])
  @@index([assessmentId])
}

model FinanceReadinessResult {
  id                    String                     @id @default(cuid())
  assessmentId          String                     @unique
  assessment            FinanceReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  overallScore          Float
  band                  ReadinessBand
  bandLabel             String
  categoryScoresJson    String
  strengthsJson         String
  weaknessesJson        String
  missingItemsJson      String
  recommendationsJson   String
  suggestedServicesJson String
  checklistJson         String
  disclaimer            String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([overallScore])
  @@index([band])
}

// Legacy readiness models
model AssessmentCategory {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  weight      Float
  orderIndex  Int                  @default(0)
  description String?
  questions   AssessmentQuestion[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([slug])
  @@index([orderIndex])
}

model AssessmentQuestion {
  id           String             @id @default(cuid())
  categoryId   String
  category     AssessmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questionKey  String             @unique
  questionText String
  helpText     String?
  type         QuestionType       @default(SINGLE_CHOICE)
  orderIndex   Int                @default(0)
  isRequired   Boolean            @default(true)
  weight       Float              @default(1.0)
  options      AssessmentOption[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([categoryId])
  @@index([questionKey])
  @@index([orderIndex])
}

model AssessmentOption {
  id                String             @id @default(cuid())
  questionId        String
  question          AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label             String
  value             String
  score             Float              @default(0)
  orderIndex        Int                @default(0)
  flagMissing       Boolean            @default(false)
  missingItemLabel  String?
  strengthTag       String?
  weaknessTag       String?
  recommendationTag String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([questionId])
}

model Assessment {
  id           String               @id @default(cuid())
  userId       String?
  user         User?                @relation(fields: [userId], references: [id])
  guestEmail   String?
  guestName    String?
  guestPhone   String?
  guestCompany String?
  status       AssessmentStatus     @default(DRAFT)
  responses    AssessmentResponse[]
  result       AssessmentResult?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
}

model AssessmentResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionKey  String
  valueString  String?
  valueNumber  Float?
  valueBoolean Boolean?
  valueJson    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, questionKey])
  @@index([assessmentId])
}

model AssessmentResult {
  id                    String        @id @default(cuid())
  assessmentId          String        @unique
  assessment            Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  overallScore          Float
  band                  ReadinessBand
  bandLabel             String
  categoryScoresJson    String
  strengthsJson         String
  weaknessesJson        String
  missingItemsJson      String
  recommendationsJson   String
  suggestedServicesJson String
  checklistJson         String
  disclaimer            String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([overallScore])
  @@index([band])
}

model AssessmentRecommendation {
  id                   String   @id @default(cuid())
  categorySlug         String
  conditionKey         String
  title                String
  description          String
  actionType           String
  suggestedServiceSlug String?
  priority             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([categorySlug])
  @@index([conditionKey])
}

model ReadinessAssessment {
  id                     String   @id @default(cuid())
  companyName            String
  contactEmail           String
  contactPhone           String?
  businessVintageYears   Int
  annualTurnoverInLakhs  Float
  netProfitMarginPercent Float
  cibilScoreBracket      String
  existingDebtInLakhs    Float
  collateralValueInLakhs Float
  gstComplianceTrack     String
  indicativeScore        Int
  riskCategory           String
  recommendedFacilities  String
  actionableInsights     String
  createdAt              DateTime @default(now())

  @@index([contactEmail])
}

// ============================================================================
// 8. BILLING, PAYMENTS & SUBSCRIPTIONS
// ============================================================================

model Invoice {
  id                String        @id @default(cuid())
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  invoiceNumber     String        @unique
  title             String        @default("Advisory Services Invoice")
  milestoneTitle    String? // Legacy alias
  description       String?
  subtotalAmount    Float         @default(0)
  taxAmount         Float         @default(0) // GST Amount
  gstAmount         Float? // Legacy alias
  amount            Float? // Legacy alias
  totalAmount       Float
  currency          String        @default("INR")
  status            InvoiceStatus @default(ISSUED)
  razorpayOrderId   String? // Legacy alias
  razorpayPaymentId String? // Legacy alias
  dueDate           DateTime
  paidAt            DateTime?
  items             InvoiceItem[]
  payments          Payment[]
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([projectId])
  @@index([organizationId])
  @@index([invoiceNumber])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  taxPercent  Float    @default(18.0) // 18% GST
  totalAmount Float
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String        @default("INR")
  paymentMethod    String        @default("BANK_TRANSFER") // RAZORPAY, NEFT_RTGS, CHEQUE, UPI
  gateway          String? // RAZORPAY, MANUAL
  gatewayPaymentId String?
  gatewayOrderId   String?
  gatewaySignature String?
  status           PaymentStatus @default(COMPLETED)
  paidAt           DateTime      @default(now())
  receiptUrl       String?
  notes            String?
  createdAt        DateTime      @default(now())

  @@index([invoiceId])
  @@index([status])
}

model Subscription {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planName           String // e.g. "Annual Retainer: Corporate Advisory"
  planCode           String
  billingInterval    String       @default("ANNUAL") // MONTHLY, QUARTERLY, ANNUAL
  amount             Float
  currency           String       @default("INR")
  status             String       @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ============================================================================
// 9. TICKETS, MESSAGES, MEETINGS & NOTIFICATIONS
// ============================================================================

model Ticket {
  id             String          @id @default(cuid())
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  ticketNumber   String          @unique
  subject        String
  description    String
  priority       TicketPriority  @default(MEDIUM)
  status         TicketStatus    @default(OPEN)
  category       String          @default("GENERAL") // DOCUMENTATION, BANK_QUERY, BILLING, DPR_REVISION
  assignedToId   String?
  assignedToName String?
  messages       TicketMessage[]
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([ticketNumber])
  @@index([status])
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])
  content        String
  attachmentKey  String?
  isInternalOnly Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@index([senderId])
}

// Legacy support ticket
model SupportTicket {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  ticketNumber   String         @unique
  subject        String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  assignedToName String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([projectId])
  @@index([status])
}

model Conversation {
  id            String           @id @default(cuid())
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  type          ConversationType @default(PROJECT_TEAM)
  messages      Message[]
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId])
  @@index([type])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("SentMessages", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?         @relation("ReceivedMessages", fields: [recipientId], references: [id])
  content        String
  attachmentKey  String?
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([projectId])
  @@index([senderId])
}

model Meeting {
  id              String        @id @default(cuid())
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultationId  String?       @unique
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  advisorName     String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int           @default(45)
  meetingUrl      String?
  status          String        @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes           String?
  recordingUrl    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([scheduledAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  actionUrl String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

// ============================================================================
// 10. KNOWLEDGE CENTRE, REGULATORY & INDUSTRY INTELLIGENCE
// ============================================================================

model KnowledgeCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  orderIndex  Int                @default(0)
  articles    KnowledgeArticle[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([slug])
  @@index([orderIndex])
}

model KnowledgeArticle {
  id                 String             @id @default(cuid())
  categoryId         String?
  categoryRef        KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  category           String // e.g. "RBI Circular", "Subsidy Scheme"
  slug               String             @unique
  title              String
  summary            String
  content            String
  sourceUrl          String
  issuingAuthority   String // RBI, Ministry of MSME, SIDBI, GST Council
  publicationDate    DateTime
  effectiveDate      DateTime
  lastReviewedDate   DateTime
  reviewedBy         String
  applicableAudience String // MSMEs, Manufacturing Units, Exporters
  status             ArticleStatus      @default(PUBLISHED)
  tags               String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([category])
  @@index([status])
}

model RegulatoryUpdate {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  circularNumber   String? // Official notification / circular code
  issuingAuthority String // RBI, Ministry of Finance, SEBI, SIDBI
  effectiveDate    DateTime
  summary          String
  impactAnalysis   String
  officialPdfUrl   String?
  status           String    @default("ACTIVE")
  tags             String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([slug])
  @@index([issuingAuthority])
  @@index([effectiveDate])
}

model Industry {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  icon                   String?
  overview               String
  typicalCostHeadsJson   String? // JSON array of capital expenditure heads
  financingStructureJson String? // JSON debt-equity-subsidy mix
  keyMetricsJson         String? // JSON benchmark DSCR, ICR, IRR
  applicableSchemesJson  String? // JSON linked government schemes
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([slug])
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  tagline          String?
  description      String
  processStepsJson String? // JSON advisory workflow steps
  deliverablesJson String? // JSON deliverables
  faqJson          String? // JSON Q&A items
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
}

model GovernmentScheme {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  nodalMinistry       String // Ministry of MSME, MoFPI, MNRE, etc.
  targetSector        String // Manufacturing, Agro-Processing, Solar, etc.
  eligibilityCriteria String
  subsidyMechanism    String // Capital Subsidy, Interest Subvention, Collateral Guarantee
  sourceUrl           String
  effectiveDate       DateTime?
  verifiedAt          DateTime?
  status              String    @default("VERIFIED")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([slug])
  @@index([nodalMinistry])
}

// ============================================================================
// 11. TASKS, ACTIVITIES, FORENSIC AUDIT & AI GOVERNANCE
// ============================================================================

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?        @relation("CreatedTasks", fields: [createdById], references: [id])
  projectId    String?
  completedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([projectId])
  @@index([status])
}

model Activity {
  id           String   @id @default(cuid())
  actorId      String?
  actorName    String
  actorRole    String
  action       String // e.g. STAGE_TRANSITION, DOCUMENT_VERIFIED, CMA_FINALIZED
  description  String
  entityType   String // Project, Lead, Document, Invoice, Application
  entityId     String?
  projectId    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actorEmail   String
  actorRole    String
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String // LOGIN_SUCCESS, ROLE_CHANGED, SENSITIVE_DOCUMENT_ACCESSED, etc.
  resource     String // User, Document, Project, Invoice
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model AIRequest {
  id               String     @id @default(cuid())
  userId           String?
  user             User?      @relation(fields: [userId], references: [id])
  projectId        String?
  promptType       String // CMA_ANALYSIS, DPR_SYNTHESIS, READINESS_REVIEW
  modelUsed        String // e.g. gemini-1.5-pro, gpt-4o
  promptTokens     Int        @default(0)
  completionTokens Int        @default(0)
  durationMs       Int        @default(0)
  status           String     @default("COMPLETED")
  outputs          AIOutput[]
  createdAt        DateTime   @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([promptType])
}

model AIOutput {
  id               String    @id @default(cuid())
  requestId        String
  request          AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  outputType       String // EXECUTIVE_SUMMARY, RATIO_ANALYSIS, RISK_RADAR
  contentJson      String
  status           String    @default("GENERATED") // GENERATED, ACCEPTED, REVISED, REJECTED
  qualityRating    Int? // 1 to 5
  reviewedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([requestId])
  @@index([status])
}
