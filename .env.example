# Application Environment Variables
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="VS Project & Financial Advisory Private Limited"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vs_project_advisory?schema=public"

# AI Gateway Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_DEFAULT_PROVIDER="gemini" # or "openai"

# AWS S3 / Private Storage (Signed URLs)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="vs-advisory-private-docs"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Communication
RESEND_API_KEY=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Auth & Security
NEXTAUTH_SECRET="development_super_secret_jwt_key_at_least_32_chars_long"
NEXTAUTH_URL="http://localhost:3000"
